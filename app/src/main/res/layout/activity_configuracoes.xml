<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/margem_tela"
            android:paddingTop="24dp"
            android:paddingEnd="@dimen/margem_tela"
            android:paddingBottom="32dp">

            <TextView
                style="@style/TituloHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_titulo" />

            <TextView
                style="@style/SubtituloHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/config_subtitulo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <com.google.android.material.card.MaterialCardView style="@style/CardEco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cfg_aparencia" />

                    <RadioGroup
                        android:id="@+id/grupoTema"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/temaClaro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/tema_claro"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp" />

                        <RadioButton
                            android:id="@+id/temaEscuro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/tema_escuro"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp" />

                        <RadioButton
                            android:id="@+id/temaSistema"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/tema_sistema"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/CardEco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cfg_conta" />

                    <TextView
                        android:id="@+id/txtConta"
                        style="@style/TextoCorpo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/btnRedefinirEmail"
                        style="@style/BotaoVoltar"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_redefinir_email" />

                    <Button
                        android:id="@+id/btnAlterarSenha"
                        style="@style/BotaoVoltar"
                        android:text="@string/senha_alterar" />

                    <Button
                        android:id="@+id/btnTrocarConta"
                        style="@style/BotaoVoltar"
                        android:text="@string/btn_trocar_conta" />

                    <Button
                        android:id="@+id/btnSairConta"
                        style="@style/BotaoEco"
                        android:text="@string/btn_sair_conta" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/CardEco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cfg_mapa" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextoCorpo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/cfg_mostrar_limpos"
                            android:textColor="@color/texto_principal" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchLimpos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/CardEco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cfg_dados" />

                    <Button
                        android:id="@+id/btnRestaurar"
                        style="@style/BotaoVoltar"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_restaurar" />

                    <Button
                        android:id="@+id/btnApagar"
                        style="@style/BotaoVoltar"
                        android:text="@string/btn_apagar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/CardEco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cfg_sobre" />

                    <TextView
                        android:id="@+id/txtVersao"
                        style="@style/TextoCorpo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <TextView
                        style="@style/TextoCorpo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sobre_texto" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnVoltar"
                style="@style/BotaoVoltar"
                android:text="@string/btn_voltar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>