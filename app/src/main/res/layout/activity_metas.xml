<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/margem_tela"
            android:paddingTop="24dp"
            android:paddingEnd="@dimen/margem_tela"
            android:paddingBottom="32dp">

            <TextView
                style="@style/TituloHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/metas_titulo" />

            <TextView
                style="@style/SubtituloHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/metas_subtitulo" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <com.google.android.material.card.MaterialCardView style="@style/CardEco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtProgresso"
                        style="@style/TituloCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/barraProgresso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:indicatorColor="@color/ciano_primario"
                        app:trackColor="@color/ciano_claro"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="12dp" />

                    <TextView
                        android:id="@+id/txtMensagem"
                        style="@style/TextoCorpo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/CardEco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <CheckBox
                        android:id="@+id/meta1"
                        style="@style/CheckMeta"
                        android:text="@string/meta_1" />

                    <CheckBox
                        android:id="@+id/meta2"
                        style="@style/CheckMeta"
                        android:text="@string/meta_2" />

                    <CheckBox
                        android:id="@+id/meta3"
                        style="@style/CheckMeta"
                        android:text="@string/meta_3" />

                    <CheckBox
                        android:id="@+id/meta4"
                        style="@style/CheckMeta"
                        android:text="@string/meta_4" />

                    <CheckBox
                        android:id="@+id/meta5"
                        style="@style/CheckMeta"
                        android:text="@string/meta_5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

                <Button
                    android:id="@+id/btnReiniciar"
                    style="@style/BotaoEco"
                    android:text="@string/btn_reiniciar" />

                <Button
                    android:id="@+id/btnVoltar"
                    style="@style/BotaoVoltar"
                    android:text="@string/btn_voltar" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
